PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/saas-manager
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_RESET_SECRET=your_reset_secret_here
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP Config for development (Ethereal)
# Leave empty to generate test account automatically, or provide explicit Ethereal credentials
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=false
SMTP_FROM_NAME=Obliq
SMTP_FROM_EMAIL=noreply@obliq.com
